---
interface Props {
  weather: {
    city: string;
    temp: number;
    condition: string;
    wind: string;
    temp_min: number;
    temp_max: number;
    note: string;
  };
}

const { weather } = Astro.props;
---

<div class="weather-box">
  <div class="weather-header">
    <span class="weather-city">{weather.city}</span>
    <span class="weather-label">Meteo</span>
  </div>

  <div class="weather-main">
    <!-- Icône Météo au trait stylisée dessin de presse -->
    <div class="weather-icon-svg" style="width: 52px; height: 52px; flex-shrink: 0;">
      <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width: 100%; height: 100%;">
        <!-- Soleil discret -->
        <circle cx="24" cy="22" r="8" stroke-dasharray="2 3" />
        <path d="M24 10V6M12 16L9 13M36 16L39 13" />
        <!-- Nuage principal -->
        <path d="M46 44H20a12 12 0 0 1-2.4-23.76A14 14 0 0 1 45 23.5 10 10 0 0 1 46 44z" fill="var(--bg-paper-card)" />
      </svg>
    </div>

    <div class="weather-temp-badge">
      <div>
        <div class="weather-temp-number">{weather.temp}°</div>
        <div class="weather-temp-cond">{weather.condition}</div>
      </div>
    </div>
  </div>

  <div class="weather-details">
    {weather.wind}
  </div>

  <div class="weather-range">
    MIN {weather.temp_min} / MAX {weather.temp_max} DEG
  </div>

  <div class="weather-quote">
    {weather.note}
  </div>
</div>
