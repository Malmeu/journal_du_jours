---
import '../styles/journal.css';

interface Props {
  title?: string;
  description?: string;
  isArticle?: boolean;
}

const {
  title = "Malmeu Matin — DZ Tech | Journal d'Actualités Algérie & Monde",
  description = "Quotidien d'information, veille startups, technologies, économie en Algérie et actualités mondiales.",
  isArticle = false
} = Astro.props;
---

<!doctype html>
<html lang="fr" data-theme="paper">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📰</text></svg>" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Polices Google Fonts pour une typographie de presse d'excellence -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,700;1,6..72,400;1,6..72,700&family=Playfair+Display:ital,wght@0,600;0,700;0,800;0,900;1,400;1,700;1,900&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/styles/journal.css" />
  </head>
  <body>
    <slot />

    <script is:inline>
      // Gestion du thème de lecture (Papier par défaut, Blanc minimaliste, Sombre encre)
      (function() {
        const savedTheme = localStorage.getItem('journal-theme') || 'paper';
        document.documentElement.setAttribute('data-theme', savedTheme);
      })();

      function toggleTheme(themeName) {
        document.documentElement.setAttribute('data-theme', themeName);
        localStorage.setItem('journal-theme', themeName);
      }

      window.setJournalTheme = toggleTheme;
    </script>
  </body>
</html>
